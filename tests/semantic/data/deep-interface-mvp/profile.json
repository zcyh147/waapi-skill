{
  "contract": "waapi-skill.deep-interface-mvp-profile/v1",
  "profile_id": "deep_interface_mvp_4",
  "model": {
    "name": "gpt-5.6-terra",
    "reasoning_effort": "medium",
    "service_tier": "default",
    "memory": "disabled"
  },
  "units": [
    {
      "unit_id": "MVP22-WEATHER",
      "family": "weather",
      "version": "2022.1",
      "prompt": "请用测试 Gateway 准备一个 Weather 层：新建 Weather Actor Mixer，把 rain 和 wind 两份素材分别作为 Rain_Bed、Wind_Bed 的 SFX 导入；两者都无限循环，音量分别为 -4 dB 和 -6 dB，并都路由到任务中绑定的 Weather_Bus。只生成业务预览，不要执行。",
      "commands": [
        ["mvp-context", "--family", "weather"],
        ["mvp-structure", "--parent", "mvp-obj-root000000000000000001", "--name", "Weather", "--kind", "actor-mixer"],
        ["mvp-asset", "--parent", "mvp-new-weather00000000000003", "--name", "Rain_Bed", "--kind", "sound-sfx", "--media", "rain", "--language", "SFX", "--volume-db", "-4", "--loop", "infinite", "--output-bus", "mvp-obj-bus000000000000000002"],
        ["mvp-asset", "--parent", "mvp-new-weather00000000000003", "--name", "Wind_Bed", "--kind", "sound-sfx", "--media", "wind", "--language", "SFX", "--volume-db", "-6", "--loop", "infinite", "--output-bus", "mvp-obj-bus000000000000000002"],
        ["mvp-preview"]
      ],
      "final_markers": ["Rain_Bed", "Wind_Bed", "Infinite", "-4 dB", "-6 dB", "未执行"]
    },
    {
      "unit_id": "MVP22-RIFLE",
      "family": "rifle",
      "version": "2022.1",
      "prompt": "现有 Rifle 对象已经由测试 Gateway 绑定。请用 rifle 素材安全重导入，保留现有对象身份；用户没有要求替换对象。只展示预览，不要执行。",
      "commands": [
        ["mvp-context", "--family", "rifle"],
        ["mvp-existing-asset", "--target", "mvp-obj-rifle0000000000000004", "--media", "rifle", "--language", "SFX"],
        ["mvp-preview"]
      ],
      "final_markers": ["Rifle", "Re-import", "未执行"]
    },
    {
      "unit_id": "MVP25-FOOTSTEPS",
      "family": "footsteps",
      "version": "2025.1",
      "prompt": "请在测试 Gateway 已绑定的 Footsteps 容器下导入 snow_step，业务名称为 Snow_Step，类型是 SFX，音量 -2 dB，输出到已绑定总线，并把 Switch 值设为 Snow。只看预览，不执行。",
      "commands": [
        ["mvp-context", "--family", "footsteps"],
        ["mvp-asset", "--parent", "mvp-obj-footsteps000000000005", "--name", "Snow_Step", "--kind", "sound-sfx", "--media", "snow_step", "--language", "SFX", "--volume-db", "-2", "--output-bus", "mvp-obj-bus000000000000000002", "--switch-value", "Snow"],
        ["mvp-preview"]
      ],
      "final_markers": ["Snow_Step", "Snow", "-2 dB", "未执行"]
    },
    {
      "unit_id": "MVP25-WEAPONS",
      "family": "weapons",
      "version": "2025.1",
      "prompt": "批量准备两条武器 SFX：mechanical 对应 Rifle_Mechanical、音量 -3 dB；tail 对应 Rifle_Tail、音量 -6 dB。两者放到测试 Gateway 已绑定的 Weapons 父对象并使用绑定总线。生成一个批量预览即可，不要执行。",
      "commands": [
        ["mvp-context", "--family", "weapons"],
        ["mvp-asset", "--parent", "mvp-obj-weapons000000000000006", "--name", "Rifle_Mechanical", "--kind", "sound-sfx", "--media", "mechanical", "--language", "SFX", "--volume-db", "-3", "--output-bus", "mvp-obj-bus000000000000000002"],
        ["mvp-asset", "--parent", "mvp-obj-weapons000000000000006", "--name", "Rifle_Tail", "--kind", "sound-sfx", "--media", "tail", "--language", "SFX", "--volume-db", "-6", "--output-bus", "mvp-obj-bus000000000000000002"],
        ["mvp-preview"]
      ],
      "final_markers": ["Rifle_Mechanical", "Rifle_Tail", "-3 dB", "-6 dB", "未执行"]
    }
  ]
}
