  "facts": {
    "none_mandatory_unremovable_initial_no_parameter_changes": {
      "archive_kind": "sdk",
      "member": "soundengine_states.html",
      "member_sha256": "8574a4890dee6bbcc227d4a0c94df4cafb707528b0868f2651a8e6d1162344a0",
      "document_title": "Integration Details - States",
      "quote": "Every state group has a state called \"None\". The \"None\" state represents the initial state of the group, and cannot be removed. In the \"None\" state, no parameter changes have been applied."
    },
    "per_group_state_names_unique": {
      "archive_kind": "authoring",
      "member": "ch19s02s02.html",
      "member_sha256": "fc5ae9bc9119dca76d6e6927b7e911bf19a3e3765a5b07e1a6b68c3b707607bf",
      "document_title": "Creating a State",
      "quote": "Each State name in a State Group must be unique and consist only of letters, digits, and underscores. Use either a letter or underscore as the first character."
    },
    "subscription_automatically_assigns_all_states": {
      "archive_kind": "authoring",
      "member": "ch19s04.html",
      "member_sha256": "4c2930b6cc245c145aa20c757d65f1f2e26005ab6270619e445149b978301a7f",
      "document_title": "Assigning States to Objects and Busses",
      "quote": "An object must first subscribe to one or multiple State Groups, and then all States within those State Groups are automatically assigned to the object."
    },
    "media_cli_forces_all_work_units_save": {
      "archive_kind": "sdk",
      "member": "ak_wwise_cli_movemediaidstosinglefile.html",
      "member_sha256": "378fe3d3121d1704f801c557fbd1ae59d9318f9f663339a15a4ae9c160f674a7",
      "document_title": "move-media-ids-to-single-file",
      "quote": "Moves the project's media IDs from its work units (.wwu) to a single file, <project-name>.mediaid. This command will force a save of all the project's work units."
    }
  },
