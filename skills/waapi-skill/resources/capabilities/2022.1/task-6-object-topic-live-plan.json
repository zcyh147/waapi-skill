  "object_read_cases": [
    {
      "id": "object_get_project_identity",
      "uri": "ak.wwise.core.object.get",
      "args": {"waql": "$ from type Project"},
      "options": {"return": ["id", "name", "type", "path"]},
      "assertions": ["return array is non-empty", "all rows are Project objects", "id/name/type/path fields are present"],
      "expected": {"result_count": {"policy": "at_least", "count": 1}, "type": "Project", "required_fields": ["id", "name", "type", "path"]},
      "no_mutation": true,
      "evidence_path": ".sisyphus/evidence/wwise-waapi-live-sandbox-coverage/object-read/object-get-project-identity.json"
    },
    {
      "id": "object_get_types_contains_project_and_sound",
      "uri": "ak.wwise.core.object.getTypes",
      "args": {},
      "options": {},
      "assertions": ["return array is non-empty", "Project and Sound type names are present", "classId/name/type fields are present"],
      "expected": {"contains_type_names": ["Project", "Sound"], "required_fields": ["classId", "name", "type"]},
      "no_mutation": true,
      "evidence_path": ".sisyphus/evidence/wwise-waapi-live-sandbox-coverage/object-read/object-get-types.json"
    },
    {
      "id": "object_property_names_for_sound_class",
      "uri": "ak.wwise.core.object.getPropertyAndReferenceNames",
      "args": {"classIdFromType": "Sound"},
      "options": {},
      "assertions": ["return array is non-empty", "Volume is listed as a Sound property/reference name"],
      "expected": {"contains": ["Volume"]},
      "no_mutation": true,
      "evidence_path": ".sisyphus/evidence/wwise-waapi-live-sandbox-coverage/object-read/sound-property-reference-names.json"
    },
    {
      "id": "object_property_info_for_sound_volume",
      "uri": "ak.wwise.core.object.getPropertyInfo",
      "args": {"classIdFromType": "Sound", "property": "Volume"},
      "options": {},
      "assertions": ["property info name is Volume", "type/default/supports metadata is present when Wwise returns it"],
      "expected": {"name": "Volume", "required_fields": ["name", "type"]},
      "no_mutation": true,
      "evidence_path": ".sisyphus/evidence/wwise-waapi-live-sandbox-coverage/object-read/sound-volume-property-info.json"
    },
    {
      "id": "object_get_attenuation_curve_when_present",
      "uri": "ak.wwise.core.object.getAttenuationCurve",
      "args": {"objectFromWaql": "$ from type Attenuation", "curveType": "VolumeDryUsage"},
      "options": {},
      "assertions": ["attenuation object lookup is deterministic", "when an attenuation exists, curveType/use fields are asserted", "when absent, evidence records skipped documented-empty behavior"],
      "expected": {"curveType": "VolumeDryUsage", "required_fields_when_present": ["curveType", "use"]},
      "no_mutation": true,
      "allow_documented_empty": true,
      "evidence_path": ".sisyphus/evidence/wwise-waapi-live-sandbox-coverage/object-read/attenuation-curve-when-present.json"
    }
  ],
