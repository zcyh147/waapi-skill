    {
      "id": "LUA23-CLI-FILE-01",
      "api": "ak.wwise.cli.executeLuaScript",
      "item_type": "function",
      "versions": ["2023.1"],
      "lane": "external_isolated",
      "scenario_family": "cli_batch_report_export",
      "scenario_index": 1,
      "prompt": "这是我逐字提供的现成 Lua 脚本 {script_file}，文件位于隔离目录 {io_root}。请不要改写脚本，直接执行它，并传入批次名 dialogue_pass_17 和输出文件名 report-dialogue-pass-17.json；完成后告诉我脚本返回的素材总数与异常总数。",
      "visible_inputs": [
        {
          "name": "script_file",
          "kind": "absolute_file_path",
          "description": "用户明确提供、已存在且位于本场景隔离目录内的 Lua 文件绝对路径"
        },
        {
          "name": "io_root",
          "kind": "absolute_directory_path",
          "description": "只属于本场景的现有非符号链接隔离目录绝对路径"
        }
      ],
      "protocol": "preview_confirm",
      "confirmation_prompt": "确认，执行刚才预览的这份脚本和参数。",
      "fixture": {
        "adapter": "lua_execution_fixture",
        "sandbox": "isolated_io_root",
        "prerequisites": [
          "隔离目录内的用户脚本逐字生成并封存路径、大小、修改时间与 SHA-256",
          "脚本只读取场景自有素材清单并写入 report-dialogue-pass-17.json",
          "预期返回值和输出文件内容由独立实现预先计算"
        ]
      },
      "trigger": null,
      "expected_dispatches": [
        {
          "api": "ak.wwise.cli.executeLuaScript",
          "count": 1,
          "effect": "执行用户提供的 Lua 文件，传入固定批次名与相对输出文件名，并返回素材统计"
        }
      ],
      "oracle_assertions": [
        {
          "phase": "before",
          "adapter": "isolated_io_unchanged_oracle",
          "subject_api": "ak.wwise.cli.executeLuaScript",
          "expectation": "脚本、素材清单和隔离目录树的路径、大小、mtime_ns 与 SHA-256 已在预览前封存"
        },
        {
          "phase": "preview",
          "adapter": "isolated_io_unchanged_oracle",
          "subject_api": "ak.wwise.cli.executeLuaScript",
          "expectation": "显式确认前没有启动脚本，隔离目录中不存在输出报告，封存输入逐字段不变"
        },
        {
          "phase": "after",
          "adapter": "lua_execution_oracle",
          "subject_api": "ak.wwise.cli.executeLuaScript",
          "expectation": "返回的 total/error 数值等于独立计算值；输出 JSON 的规范化内容、大小和 SHA-256 等于隐藏基线，脚本文件本身未改变"
        }
      ],
      "cleanup": {
        "adapter": "lua_execution_cleanup",
        "postconditions": [
          "owned_state_removed_or_restored",
          "project_source_unchanged",
          "case_owned_io_root_removed_on_success",
          "failed_or_indeterminate_io_root_sealed_and_never_reused"
        ]
      }
    },
