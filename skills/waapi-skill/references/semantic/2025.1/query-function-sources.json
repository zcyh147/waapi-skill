  "sections": {
    "isLinked": {
      "html_lines": [
        1268,
        1277
      ],
      "html": "<tr>\r\n<td><p class=\"starttd\"></p>\r\n<p class=\"intertd\"><span style=\"color: rgb(23,43,77);\">isLinked(&quot;<b>PROPERTY_NAME</b>&quot;)</span></p>\r\n<p class=\"endtd\"></p>\r\n</td><td><p class=\"starttd\"></p>\r\n<p class=\"intertd\">Returns true if the specified property of the current object is linked.</p>\r\n<p class=\"intertd\"></p>\r\n<p class=\"intertd\"><b>PROPERTY_NAME</b> refers to the name of a property, reference or object list for the current object. Refer to <a class=\"el\" href=\"wobjects_index.html\">Wwise Objects Reference</a> for the complete list of object types and their properties. The name is case-insensitive.</p>\r\n<p class=\"endtd\"></p>\r\n</td><td>$ where <span style=\"color: rgb(23,43,77);\">isLinked(&quot;pitch&quot;)</span> </td></tr>\r\n",
      "sha256": "10c371eee499451697886ef2c30658433b4e96d1b49d5f95ef67f507186676ff"
    },
    "isOverridable": {
      "html_lines": [
        1278,
        1287
      ],
      "html": "<tr>\r\n<td><p class=\"starttd\"></p>\r\n<p class=\"intertd\"><span style=\"color: rgb(23,43,77);\">isOverridable(&quot;<b>PROPERTY_NAME</b>&quot;)</span></p>\r\n<p class=\"endtd\"></p>\r\n</td><td><p class=\"starttd\"></p>\r\n<p class=\"intertd\">Returns true if the specified property of the current object has an override property.</p>\r\n<p class=\"intertd\"></p>\r\n<p class=\"intertd\"><b>PROPERTY_NAME</b> refers to the name of a property, reference or object list for the current object. Refer to <a class=\"el\" href=\"wobjects_index.html\">Wwise Objects Reference</a> for the complete list of object types and their properties. The name is case-insensitive.</p>\r\n<p class=\"endtd\"></p>\r\n</td><td>$ where <span style=\"color: rgb(23,43,77);\">isOverridable(&quot;SpeakerPanning&quot;)</span> </td></tr>\r\n",
      "sha256": "b3937579b877337098834962881ca5852584fce39c09c6ab81e22a0e59e586e5"
    },
    "isSourceOfOverride": {
      "html_lines": [
        1288,
        1297
      ],
      "html": "<tr>\r\n<td><p class=\"starttd\"></p>\r\n<p class=\"intertd\"><span style=\"color: rgb(23,43,77);\">isSourceOfOverride(&quot;<b>PROPERTY_NAME</b>&quot;)</span></p>\r\n<p class=\"endtd\"></p>\r\n</td><td><p class=\"starttd\"></p>\r\n<p class=\"intertd\">Returns true if the object is the source of override for the specified property.</p>\r\n<p class=\"intertd\"></p>\r\n<p class=\"intertd\"><b>PROPERTY_NAME</b> refers to the name of a property, reference or object list for the current object. Refer to <a class=\"el\" href=\"wobjects_index.html\">Wwise Objects Reference</a> for the complete list of object types and their properties. The name is case-insensitive.</p>\r\n<p class=\"endtd\"></p>\r\n</td><td>$ where <span style=\"color: rgb(23,43,77);\">isSourceOfOverride(&quot;SpeakerPanning&quot;)</span> </td></tr>\r\n",
      "sha256": "1cc838f74bcc021dbcbb742d2a6cad7e12b4b41c5fecfe919adfdc78e3daa667"
    },
    "hasProperty": {
      "html_lines": [
        1320,
        1331
      ],
      "html": "<tr>\r\n<td><p class=\"starttd\"></p>\r\n<p class=\"intertd\"><span style=\"color: rgb(23,43,77);\">hasProperty(&quot;<b>PROPERTY_NAME</b>&quot;)</span></p>\r\n<p class=\"endtd\"></p>\r\n</td><td><p class=\"starttd\"></p>\r\n<p class=\"intertd\">Returns true if the object has the specified property.</p>\r\n<p class=\"intertd\"></p>\r\n<p class=\"intertd\"><b>PROPERTY_NAME</b> refers to the name of a property, reference or object list for the current object. Refer to <a class=\"el\" href=\"wobjects_index.html\">Wwise Objects Reference</a> for the complete list of object types and their properties. The name is case-insensitive.</p>\r\n<p class=\"endtd\"></p>\r\n</td><td><p class=\"starttd\">$ where <span style=\"color: rgb(23,43,77);\">hasProperty(&quot;InitialDelay&quot;)</span></p>\r\n<p class=\"endtd\"></p>\r\n</td></tr>\r\n",
      "sha256": "2a65b2a8e5f90ec2da69d922cb4111afe0c8f945e30ac1e007a5d87c233b660c"
    },
    "curveToUse": {
      "html_lines": [
        1456,
        1469
      ],
      "html": "<tr>\r\n<td><p class=\"starttd\"></p>\r\n<p class=\"intertd\"><span style=\"color: rgb(23,43,77);\">curveToUse</span></p>\r\n<p class=\"endtd\"></p>\r\n</td><td><p class=\"starttd\"></p>\r\n<p class=\"intertd\">For the current Attenuation object this returns a string representing the curve to use for a given curve type.</p>\r\n<p class=\"intertd\"></p>\r\n<p class=\"intertd\">See <a class=\"el\" href=\"ak_wwise_core_object_setattenuationcurve.html\">ak.wwise.core.object.setAttenuationCurve</a> for the list of curve types and uses.</p>\r\n<p class=\"intertd\"></p>\r\n<p class=\"intertd\"><b>Note</b>: This only works with objects of type Attenuation.</p>\r\n<p class=\"endtd\"></p>\r\n</td><td><p class=\"starttd\">$ from type Attenuation where <span style=\"color: rgb(23,43,77);\">curveToUse(&quot;VolumeWetGameUsage&quot;)</span> = \"UseVolumeDry\"</p>\r\n<p class=\"endtd\"></p>\r\n</td></tr>\r\n",
      "sha256": "927a389a6d6950d6fedda6d875918f954338acec606439556d385a19c59f7595"
    }
  },
